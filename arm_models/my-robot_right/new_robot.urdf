<robot name="gello">
  <!-- Fixed base link representing the mounting point -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>  <!-- Tiny nominal mass -->
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <!-- Connect base to assembly_2 -->
  <joint name="base_to_assembly_2" type="fixed">
